# Online Car Rental Management System - Environment Variables
SECRET_KEY=driveease-secret-key-2026-supersecure

# Database Type: 'mysql' or 'sqlite'
DB_TYPE=mysql

# MySQL Database Configuration (XAMPP / MySQL Server defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=car_rental_db

# Fallback to SQLite if MySQL is offline (set to false to enforce strict MySQL)
USE_SQLITE_FALLBACK=true
